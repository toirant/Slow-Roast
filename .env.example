# Slow Roast Coffee Club - Environment Configuration Example
# Copy to .env for local configuration. Never commit actual secret keys.

# Server Port (AI Studio container port is 3000)
PORT=3000
NODE_ENV=development

# Stripe Live / Test Mode Configuration
# Leave blank to run in Demo Simulation Mode (no Stripe account required)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# Business Contact & Support (Optional overrides)
ROASTER_BUSINESS_NAME="Slow Roast Coffee Club"
ROASTER_SUPPORT_EMAIL="roaster@slowroastcoffee.club"
